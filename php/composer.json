            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "bucketlist",
        "bucket list api",
        "random bucket list ideas",
        "life goals generator",
        "travel bucket list ideas",
        "things to do before you die"
    ],
    "homepage": "https://apiverve.com/marketplace/bucketlist?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/bucketlist",
        "source": "https://github.com/apiverve/bucketlist-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Bucketlist\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "APIVerve\\Bucketlist\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
